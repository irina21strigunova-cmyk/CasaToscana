# Public site URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# T-Bank Internet Acquiring — TEST terminal
# Paste Terminal Key and Password from T-Business cabinet (never commit real values)
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=

# Optional
# TBANK_API_URL=https://securepay.tinkoff.ru

# Protects POST /api/payments/refund, /api/payments/closing-receipt
# /api/payments/confirm-delivery and /admin/*
# Send as Authorization: Bearer <secret>, header x-ops-secret,
# or sign in at /admin/login (HttpOnly cookie).
TBANK_OPS_SECRET=

# Durable orders (required for unpaid CDEK checkout). Server-only.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Order emails via Resend. Without these, the order is still saved.
# RESEND_API_KEY=
# EMAIL_FROM=Casa Toscana <noreply@casatoscana.ru>
# ORDER_NOTIFY_EMAIL=CasaToscana@outlook.com

# Vercel Production: extra trust for Минцифры CAs (do not disable TLS)
# The app also loads certs/russian-trusted-ca-bundle.pem at runtime.
# NODE_EXTRA_CA_CERTS=/var/task/certs/russian-trusted-ca-bundle.pem

# CDEK API v2 — server-side only, never NEXT_PUBLIC_
# CDEK_CLIENT_ID=
# CDEK_CLIENT_SECRET=
# Optional. Default production: https://api.cdek.ru
# CDEK_API_BASE_URL=https://api.cdek.ru
# Origin city code (Moscow = 44)
# CDEK_FROM_LOCATION_CODE=44
# Exact pickup address, when confirmed:
# CDEK_FROM_ADDRESS=
