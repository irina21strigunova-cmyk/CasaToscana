# Public site URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# T-Bank Internet Acquiring — TEST terminal
# Paste Terminal Key and Password from T-Business cabinet (never commit real values)
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=

# Optional
# TBANK_API_URL=https://securepay.tinkoff.ru

# Protects POST /api/payments/refund and /api/payments/closing-receipt
# Send as Authorization: Bearer <secret> or header x-ops-secret
TBANK_OPS_SECRET=

# Vercel Production: extra trust for Минцифры CAs (do not disable TLS)
# The app also loads certs/russian-trusted-ca-bundle.pem at runtime.
# NODE_EXTRA_CA_CERTS=/var/task/certs/russian-trusted-ca-bundle.pem
